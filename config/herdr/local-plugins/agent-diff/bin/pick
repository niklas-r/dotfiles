#!/usr/bin/env python3
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
import runner

pane = os.environ["HERDR_PANE_ID"]
runner.run(["herdr", "plugin", "pane", "open", "--plugin", "niklas.agent-diff",
            "--entrypoint", "menu", "--env", f"AGENT_DIFF_PANE={pane}"])
