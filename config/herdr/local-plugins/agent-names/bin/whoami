#!/usr/bin/env python3
"""Tell the agent in this pane who it is, or list every named agent.

Usage: whoami [--wait SECONDS] | whoami --list
"""

import argparse
import os
import sys
import time

sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))

import agent_names as an


CALL_TIMEOUT = 5


def current_name(pane_id, timeout=CALL_TIMEOUT):
    try:
        return an.herdr("agent", "get", pane_id, timeout=timeout)["agent"].get("name")
    except (an.HerdrError, OSError):  # OSError: herdr binary missing or broken
        return None


SCOPE_NOTE = (
    "Scope: your personality is a light running gag for your chat replies to the user only: "
    "tone, word choice, the odd quip. It must not change your reasoning, accuracy, "
    "thoroughness, decisions, code, commit messages, docs, or messages to other agents. "
    "Drop it whenever it would hurt clarity."
)


def describe(name, names):
    display, flair = an.display_for(name, names)
    text = f"You are {display} (herdr agent name: {name})."
    if flair:
        text += f" Personality: {flair}"
    text += f' Other agents can reach you with: herdr agent prompt {name} "..."'
    return f"{text}\n{SCOPE_NOTE}"


def main():
    parser = argparse.ArgumentParser(description="Show this pane's agent name and personality.")
    parser.add_argument("--list", action="store_true", help="list all live named agents")
    parser.add_argument("--wait", type=float, metavar="SECONDS",
                        help="wait for the pane to be named; print nothing and exit 0 on timeout")
    args = parser.parse_args()
    names = an.load_names()

    if args.list:
        timeout = min(CALL_TIMEOUT, max(args.wait, 0.1)) if args.wait is not None else CALL_TIMEOUT
        try:
            agents = an.herdr("agent", "list", timeout=timeout)["agents"]
        except (an.HerdrError, OSError):
            if args.wait is not None:
                return 0
            raise
        for agent in agents:
            if agent.get("name"):
                display, flair = an.display_for(agent["name"], names)
                print(f"{agent['name']}\t{display} ({agent['agent']}, {agent['pane_id']})\t{flair}")
        print(SCOPE_NOTE)
        return 0

    pane_id = os.environ.get("HERDR_PANE_ID")
    if not pane_id:
        if args.wait is not None:
            return 0
        print("whoami: not inside a Herdr pane (HERDR_PANE_ID is unset)", file=sys.stderr)
        return 1

    if args.wait is not None:
        deadline = time.monotonic() + args.wait
        while True:
            # Each call may only use what is left of the wait.
            name = current_name(pane_id, timeout=max(deadline - time.monotonic(), 0.1))
            remaining = deadline - time.monotonic()
            if name or remaining <= 0:
                break
            time.sleep(min(0.5, remaining))
        if not name:
            return 0
    else:
        name = current_name(pane_id)
    if not name:
        print(f"whoami: pane {pane_id} has no named agent", file=sys.stderr)
        return 1
    print(describe(name, names))
    return 0


if __name__ == "__main__":
    sys.exit(main())
